#!/bin/sh
# systemd generator: auto-login on tty1 for session.autologin (gideon-config).
# Runs at every boot/daemon-reload before units are loaded; $1 = output dir.
PATH=/usr/bin:/usr/sbin
user="$(gideon-config get session.autologin "" 2>/dev/null)"
[ -n "$user" ] || exit 0
case "$user" in *[!a-z0-9_-]*) exit 0 ;; esac
grep -q "^$user:" /etc/passwd || exit 0
mkdir -p "$1/getty@tty1.service.d"
cat > "$1/getty@tty1.service.d/50-gideon-autologin.conf" <<UNIT
# Generated by gideon-session-generator from session.autologin
[Service]
ExecStart=
ExecStart=-/sbin/agetty -o '-p -f -- \\\\u' --noclear --autologin $user %I \$TERM
UNIT
