#!/bin/sh
# Start the graphical session for the logged-in user on this VT.
# Milestone 3 uses Weston as an interim compositor to validate the graphics
# stack (DRM/KMS, libinput, Mesa, Wayland); gideon-compositor replaces it (M4).
# Settings come from gideon-config: display.*, input.keyboard_layout.
dir="$XDG_RUNTIME_DIR/gideon"
mkdir -p "$dir"
ini="$dir/weston.ini" log="$dir/compositor.log"
cfg() { gideon-config get "$1" "$2"; }

mode="$(cfg display.mode preferred)"
scale="$(cfg display.scale 1)"
case "$scale" in ''|*[!0-9]*) scale=1 ;; esac
renderer="$(cfg display.renderer pixman)"
case "$renderer" in gl|pixman) ;; *) renderer=pixman ;; esac
bg="$(cfg display.background 0f1216)"
case "$bg" in [0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) ;; *) bg=0f1216 ;; esac

{
    echo "# Generated by $0 from gideon-config; edits are overwritten."
    echo "[core]"
    echo "idle-time=0"
    echo "require-input=false"
    echo
    echo "[shell]"
    echo "background-color=0xff$bg"
    echo "panel-color=0xff171b21"
    echo "panel-position=bottom"
    echo "clock-format=minutes"
    echo "locking=false"
    echo "animation=none"
    echo
    echo "[keyboard]"
    echo "keymap_layout=$(cfg input.keyboard_layout us)"
    echo
    echo "[terminal]"
    echo "font=DejaVu Sans Mono"
    echo "font-size=14"
    echo
    echo "[launcher]"
    echo "icon=/usr/share/weston/icon_terminal.png"
    echo "path=/usr/bin/weston-terminal"
    # One [output] section per connected connector (e.g. card0-Virtual-1).
    for c in /sys/class/drm/card[0-9]*-*; do
        [ "$(cat "$c/status" 2>/dev/null)" = connected ] || continue
        name="${c##*/}"; name="${name#card*-}"
        echo
        echo "[output]"
        echo "name=$name"
        echo "mode=$mode"
        echo "scale=$scale"
    done
} > "$ini"

start="$(date +%s)"
weston --backend=drm --renderer="$renderer" --shell=desktop \
       --config="$ini" --log="$log"
rc=$?
if [ "$rc" -ne 0 ] && [ $(( $(date +%s) - start )) -lt 15 ]; then
    echo "gideon: the graphical session failed to start (exit $rc)."
    echo "gideon: log: $log — starting a text shell instead."
    tail -n 15 "$log" 2>/dev/null
    exec /bin/sh -l
fi
exit "$rc"
