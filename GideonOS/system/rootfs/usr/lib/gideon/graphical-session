#!/bin/sh
# Start the graphical session for the logged-in user on this VT:
# gideon-compositor on DRM/KMS. It reads display.*, input.keyboard_layout and
# session.terminal from gideon-config itself. Log: $XDG_RUNTIME_DIR/gideon/compositor.log
dir="$XDG_RUNTIME_DIR/gideon"
mkdir -p "$dir"
log="$dir/compositor.log"

start="$(date +%s)"
gideon-compositor --backend udev > "$log" 2>&1
rc=$?
# Fall back to a text shell only for a real startup failure (non-zero exit
# soon after starting). A clean exit (0) or death by a signal (>128) ends the
# session; on the live image autologin then starts a fresh one.
if [ "$rc" -ne 0 ] && [ "$rc" -le 128 ] && [ $(( $(date +%s) - start )) -lt 15 ]; then
    echo "gideon: the graphical session failed to start (exit $rc)."
    echo "gideon: log: $log — starting a text shell instead."
    tail -n 15 "$log" 2>/dev/null
    exec /bin/sh -l
fi
exit "$rc"
