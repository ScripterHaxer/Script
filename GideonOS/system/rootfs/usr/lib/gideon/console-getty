#!/bin/sh
# Run a login prompt on the given tty, or idle if the tty has no hardware
# behind it (e.g. no serial port on real hardware) so init does not respawn-loop.
if [ "$(cat "/sys/class/tty/$1/type" 2>/dev/null)" = 0 ] || [ ! -c "/dev/$1" ]; then
    exec sleep 2147483647
fi
case "$1" in
    ttyS*) exec /sbin/getty -l /usr/lib/gideon/login -L 115200 "$1" vt100 ;;
    *)     exec /sbin/getty -l /usr/lib/gideon/login 38400 "$1" linux ;;
esac
