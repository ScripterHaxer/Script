#!/bin/sh
# Apply GideonOS configuration to the system services that consume it.
# Run at boot by gideon-config-apply.service and by `gideon-config apply`.
set -u
PATH=/usr/bin:/usr/sbin
cfg() { gideon-config get "$1" "$2"; }

# --- identity ---------------------------------------------------------------
host="$(cfg system.hostname gideon)"
case "$host" in ''|-*|*[!a-zA-Z0-9-]*) echo "config-apply: invalid hostname '$host', using gideon" >&2; host=gideon ;; esac
echo "$host" > /etc/hostname
hostname "$host"
sed -i "s/^127\.0\.1\.1[[:space:]].*/127.0.1.1   $host/" /etc/hosts

# --- time zone ---------------------------------------------------------------
tz="$(cfg time.timezone UTC)"
case "$tz" in *..*|/*) tz=UTC ;; esac
if [ -f "/usr/share/zoneinfo/$tz" ]; then
    ln -sf "../usr/share/zoneinfo/$tz" /etc/localtime
else
    echo "config-apply: unknown time zone '$tz', keeping $(readlink /etc/localtime)" >&2
fi

# --- wired network (systemd-networkd) ----------------------------------------
mkdir -p /run/systemd/network
ifaces="$(cfg network.interfaces auto)"
dhcp=no; [ "$(cfg network.dhcp true)" = true ] && dhcp=ipv4
sendhost=no; [ "$(cfg network.send_hostname true)" = true ] && sendhost=yes
{
    echo "# Generated by /usr/lib/gideon/config-apply from gideon-config network.*"
    echo "[Match]"
    if [ "$ifaces" = auto ]; then printf 'Type=ether\nKind=!*\n'; else echo "Name=$ifaces"; fi
    echo; echo "[Network]"
    echo "DHCP=$dhcp"
    echo "IPv6AcceptRA=yes"
    echo; echo "[DHCPv4]"
    echo "SendHostname=$sendhost"
} > /run/systemd/network/80-gideon-wired.network.tmp
mv /run/systemd/network/80-gideon-wired.network.tmp /run/systemd/network/80-gideon-wired.network

# --- time synchronisation (systemd-timesyncd) --------------------------------
mkdir -p /run/systemd/timesyncd.conf.d
printf '# Generated by config-apply from time.ntp_servers\n[Time]\nNTP=%s\n' \
    "$(cfg time.ntp_servers pool.ntp.org)" > /run/systemd/timesyncd.conf.d/50-gideon.conf
exit 0
