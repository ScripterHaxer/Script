#!/bin/sh
# udhcpc event handler: apply the DHCP lease to the interface and DNS.
RESOLV=/run/gideon/resolv.conf
case "$1" in
    deconfig)
        ip -4 addr flush dev "$interface"
        ip link set "$interface" up
        ;;
    bound|renew)
        ip -4 addr flush dev "$interface"
        ip -4 addr add "$ip/${mask:-24}" ${broadcast:+broadcast "$broadcast"} dev "$interface"
        # (addr add also creates the on-link subnet route the gateway needs)
        for r in $router; do
            ip -4 route replace default via "$r" dev "$interface" && break
        done
        tmp="$RESOLV.$$"
        { echo "# generated by GideonOS dhcp@$interface"
          [ -n "$domain" ] && echo "search $domain"
          for s in $dns; do echo "nameserver $s"; done; } > "$tmp"
        mv "$tmp" "$RESOLV"
        echo "$interface: lease $ip/${mask:-24} router ${router:-none} dns ${dns:-none}"
        logger -t dhcp "$interface: $1 $ip/${mask:-24} via ${router:-none}"
        ;;
    leasefail|nak)
        echo "$interface: no DHCP lease ($1)"
        ;;
esac
exit 0
