description="Wired network configuration"
requires="syslog"
type=oneshot
ifaces() {
    want="$(gideon-config get network.interfaces auto)"
    if [ "$want" = auto ]; then
        for d in /sys/class/net/*; do
            n="${d##*/}"
            [ "$n" = lo ] && continue
            [ -d "$d/wireless" ] && continue              # Wi-Fi: M9
            [ "$(cat "$d/type" 2>/dev/null)" = 1 ] || continue  # ARPHRD_ETHER
            [ -e "$d/device" ] || continue                # physical only
            echo "$n"
        done
    else
        echo "$want"
    fi
}
start() {
    ip link set lo up
    ln -sf /run/gideon/resolv.conf /etc/resolv.conf 2>/dev/null
    [ -f /run/gideon/resolv.conf ] || : > /run/gideon/resolv.conf
    for i in $(ifaces); do
        ip link set "$i" up
        echo "$i: link up (IPv6 SLAAC handled by the kernel)"
        if [ "$(gideon-config get network.dhcp true)" = true ]; then
            gideon-service start "dhcp@$i" || echo "$i: DHCP client failed to start"
        fi
    done
}
stop() {
    for d in /run/gideon/services/dhcp@*; do
        [ -d "$d" ] && gideon-service stop "${d##*/}"
    done
    return 0
}
