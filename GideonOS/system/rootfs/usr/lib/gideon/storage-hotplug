#!/bin/sh
# storage-hotplug add|remove DEVICE
# Mount a removable/USB filesystem under /media/<label>, or unmount it.
# Called by gideon-automount@DEVICE.service (udev rule 80-gideon-automount).
PATH=/usr/bin:/usr/sbin
action="${1:-}" dev="${2:-}"
case "$dev" in ''|*/*|.*) echo "storage-hotplug: bad device '$dev'" >&2; exit 2 ;; esac
state="/run/gideon/media/$dev"
mkdir -p /run/gideon/media /media

if [ "$action" = remove ]; then
    [ -f "$state" ] || exit 0
    mp="$(cat "$state")"
    umount "$mp" 2>/dev/null || umount -l "$mp"
    rmdir "$mp" 2>/dev/null
    rm -f "$state"
    echo "unmounted /dev/$dev from $mp"
    exit 0
fi
[ "$action" = add ] || { echo "usage: storage-hotplug add|remove DEVICE" >&2; exit 2; }

[ "$(gideon-config get storage.automount true)" = true ] || { echo "automount disabled"; exit 0; }
[ -f "$state" ] && exit 0
grep -q "^/dev/$dev " /proc/mounts && { echo "/dev/$dev already mounted (e.g. boot medium)"; exit 0; }

type="$(blkid -o value -s TYPE "/dev/$dev")" || exit 0
label="$(blkid -o value -s LABEL "/dev/$dev")"
case " $(gideon-config get storage.automount_types "vfat ext4") " in
    *" $type "*) ;;
    *) echo "/dev/$dev: filesystem '$type' not in storage.automount_types"; exit 0 ;;
esac

name="$(printf '%s' "${label:-$dev}" | tr -c 'A-Za-z0-9._-' '_')"
[ -n "$name" ] || name="$dev"
mp="/media/$name"; n=1
while grep -q " $mp " /proc/mounts; do n=$((n + 1)); mp="/media/$name-$n"; done
mkdir -p "$mp"

opts="nosuid,nodev"
case "$type" in
    vfat|exfat) opts="$opts,uid=0,gid=$(awk -F: '$1 == "users" { print $3 }' /etc/group),umask=002" ;;  # writable by group users
    iso9660)    opts="$opts,ro" ;;
esac
if mount -t "$type" -o "$opts" "/dev/$dev" "$mp"; then
    echo "$mp" > "$state"
    echo "mounted /dev/$dev ($type${label:+, label $label}) at $mp"
else
    rmdir "$mp"
    echo "failed to mount /dev/$dev ($type)" >&2
    exit 1
fi
