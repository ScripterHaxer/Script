#!/bin/sh
# gideon-session: login shell for GideonOS users.
#
# On a virtual terminal (tty1, ...) with session.graphical = true it starts the
# graphical session; elsewhere (serial console, su -, ssh) it runs a shell.
#   gideon-session --list    show active login sessions (systemd-logind)
if [ "${1:-}" = --list ]; then
    exec loginctl list-sessions --no-pager
fi
# Non-interactive use (su -c, scripts) passes straight to the shell.
[ $# -gt 0 ] && exec /bin/sh "$@"

export SHELL=/bin/sh XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
# System locale for every session type (the graphical path never reads /etc/profile).
if [ -z "${LANG:-}" ] && [ -r /etc/locale.conf ]; then
    . /etc/locale.conf
    export LANG
fi
case "$(tty 2>/dev/null)" in
    /dev/tty[0-9]*)
        if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -n "${XDG_RUNTIME_DIR:-}" ] &&
           [ "$(gideon-config get session.graphical true)" = true ]; then
            exec /usr/lib/gideon/graphical-session
        fi ;;
esac
exec /bin/sh -l
