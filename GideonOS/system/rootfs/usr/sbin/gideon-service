#!/bin/sh
# gideon-service: the GideonOS service manager (milestone 2, BusyBox based).
#
#   gideon-service start|stop|restart|status NAME...
#   gideon-service enable|disable NAME     (start at boot; /etc/gideon/services.enabled)
#   gideon-service list                    all known services with state
#   gideon-service boot | shutdown         used by rc.boot / rc.shutdown
#
# A service is a shell fragment in /usr/lib/gideon/services/NAME (an admin
# override with the same name in /etc/gideon/services/ wins). Templates are
# named NAME@ and instantiated as NAME@INSTANCE (e.g. dhcp@eth0), with
# $instance set. Variables a service may define:
#   description="..."   requires="other services"
#   type=daemon         exec="foreground command"  - supervised by runsv,
#                       restarted if it dies; output -> /var/log/gideon/NAME/
#   type=oneshot        start() { ...; }  stop() { ...; }  (stop optional)
#                       output -> /var/log/gideon/NAME.log
# A daemon may also define prepare(), run (as root) before each launch; it may
# compute $exec from configuration.
set -u
[ "${GIDEON_DEBUG:-}" = 1 ] && set -x
PATH=/usr/sbin:/usr/bin:/sbin:/bin

SYSDIR=/usr/lib/gideon/services
ADMINDIR=/etc/gideon/services
ENABLED=/etc/gideon/services.enabled
RUN=/run/gideon/services
LOGDIR=/var/log/gideon

die() { echo "gideon-service: $*" >&2; exit 2; }

valid_name() {
    case "$1" in ''|*[!a-zA-Z0-9_@.-]*|*@*@*|@*) return 1 ;; esac
}

definition() { # path of the definition file for service $1
    local base="$1"
    case "$1" in *@?*) base="${1%%@*}@" ;; esac
    for d in "$ADMINDIR" "$SYSDIR"; do
        [ -f "$d/$base" ] && { echo "$d/$base"; return 0; }
    done
    return 1
}

load() { # load definition of $1 into the current (sub)shell
    description="" requires="" type=oneshot exec=""
    instance=""; case "$1" in *@?*) instance="${1#*@}" ;; esac
    unset -f start stop prepare 2>/dev/null
    # shellcheck disable=SC1090
    . "$(definition "$1")"
}

state()  { cat "$RUN/$1/state" 2>/dev/null || echo inactive; }
setstate() { mkdir -p "$RUN/$1"; echo "$2" > "$RUN/$1/state"; }

is_running_daemon() { sv status "$RUN/$1/sv" 2>/dev/null | grep -q '^run:'; }

do_start() { # do_start NAME [CHAIN] - CHAIN detects dependency cycles
    local name="$1" chain="${2:-}" dep
    valid_name "$name" || die "invalid service name '$name'"
    definition "$name" >/dev/null || { echo "gideon-service: unknown service '$name'" >&2; return 1; }
    case " $chain " in *" $name "*) echo "gideon-service: dependency cycle: $chain $name" >&2; return 1 ;; esac
    [ "$(state "$name")" = active ] && return 0

    for dep in $( (load "$name"; echo "$requires") ); do
        do_start "$dep" "$chain $name" || { echo "gideon-service: $name: dependency $dep failed" >&2; setstate "$name" failed; return 1; }
    done

    mkdir -p "$RUN/$name" "$LOGDIR"
    svtype="$( (load "$name"; echo "$type") )"
    if [ "$svtype" = daemon ]; then
        start_daemon "$name" || { setstate "$name" failed; return 1; }
    else
        if ( load "$name"; start ) >> "$LOGDIR/$name.log" 2>&1; then :; else
            echo "gideon-service: $name failed (see $LOGDIR/$name.log)" >&2
            setstate "$name" failed; return 1
        fi
    fi
    setstate "$name" active
    echo "$name" >> /run/gideon/services.order
    return 0
}

start_daemon() {
    local name="$1" dir="$RUN/$1/sv" i
    rm -rf "$dir"; mkdir -p "$dir/log" "$LOGDIR/$name"
    # runsv executes ./run; it reloads the definition each time so a crashed
    # daemon restarts with current configuration.
    cat > "$dir/run" <<RUNEOF
#!/bin/sh
exec 2>&1
PATH=$PATH
name='$name'
GIDEON_SERVICE_LIB=1 . /usr/sbin/gideon-service
load "\$name"
if command -v prepare >/dev/null 2>&1; then prepare || exit 1; fi
eval "exec \$exec"
RUNEOF
    cat > "$dir/log/run" <<RUNEOF
#!/bin/sh
exec svlogd -tt $LOGDIR/$name
RUNEOF
    chmod 755 "$dir/run" "$dir/log/run"
    # fd 9 is the manager lock: the daemon must not inherit it.
    setsid runsv "$dir" </dev/null >/dev/null 2>&1 9>&- &
    # Consider it started once runsv reports the process running for 1s.
    i=0
    while [ $i -lt 50 ]; do
        if is_running_daemon "$name"; then
            up="$(sv status "$dir" | sed -n 's/^run: [^ ]* (pid [0-9]*) \([0-9]*\)s.*/\1/p')"
            [ "${up:-0}" -ge 1 ] && return 0
        fi
        sleep 0.1; i=$((i + 1))
    done
    echo "gideon-service: $name did not stay running (see $LOGDIR/$name/current)" >&2
    sv force-shutdown "$dir" >/dev/null 2>&1
    return 1
}

do_stop() {
    local name="$1" svtype
    valid_name "$name" || die "invalid service name '$name'"
    [ "$(state "$name")" = inactive ] && return 0
    svtype="$( (load "$name"; echo "$type") 2>/dev/null )"
    if [ "$svtype" = daemon ]; then
        sv force-stop "$RUN/$name/sv" >/dev/null 2>&1
        sv exit "$RUN/$name/sv" >/dev/null 2>&1
        sv exit "$RUN/$name/sv/log" >/dev/null 2>&1
    else
        ( load "$name"; if command -v stop >/dev/null 2>&1; then stop; fi ) >> "$LOGDIR/$name.log" 2>&1
    fi
    rm -rf "$RUN/$name"
    return 0
}

do_status() {
    local name="$1" st detail=""
    definition "$name" >/dev/null || { echo "$name: unknown"; return 4; }
    st="$(state "$name")"
    desc="$( (load "$name"; echo "$description") )"
    if [ "$st" = active ] && [ -d "$RUN/$name/sv" ]; then
        detail="$(sv status "$RUN/$name/sv" 2>/dev/null | sed -n 's/^run: [^ ]* (pid \([0-9]*\)) \([0-9]*\)s.*/pid \1, up \2s/p')"
        [ -n "$detail" ] || { st=failed; detail="supervised process not running"; }
    fi
    printf '%-14s %-9s %s%s\n' "$name" "$st" "$desc" "${detail:+ ($detail)}"
    case "$st" in active) return 0 ;; failed) return 1 ;; *) return 3 ;; esac
}

# Serialise state changes. Nested calls (a oneshot starting another service,
# e.g. network -> dhcp@eth0) already hold the lock and must not take it again.
locked() { # locked start|stop|restart NAME
    if [ "${GIDEON_SERVICE_LOCKED:-}" = 1 ]; then run_cmd "$@"; return $?; fi
    (
        flock 9
        export GIDEON_SERVICE_LOCKED=1
        run_cmd "$@"
    ) 9>/run/gideon/services.lock
}
run_cmd() {
    case "$1" in
        start)   do_start "$2" ;;
        stop)    do_stop "$2" ;;
        restart) do_stop "$2"; do_start "$2" ;;
    esac
}

enabled_list() { sed -e 's/#.*//' -e '/^[[:space:]]*$/d' "$ENABLED" 2>/dev/null; }

# Allow the generated run scripts to reuse load() without running a command.
[ "${GIDEON_SERVICE_LIB:-}" = 1 ] && return 0

cmd="${1:-}"; [ $# -gt 0 ] && shift
case "$cmd" in
    start|stop|restart)
        [ $# -ge 1 ] || die "usage: $cmd NAME..."
        [ "$(id -u)" = 0 ] || die "must be run as root"
        rc=0
        for n in "$@"; do
            locked "$cmd" "$n" || rc=1
        done
        exit $rc ;;
    status)
        [ $# -ge 1 ] || die "usage: status NAME..."
        rc=0; for n in "$@"; do do_status "$n" || rc=$?; done; exit $rc ;;
    list)
        { ls "$SYSDIR" "$ADMINDIR" 2>/dev/null | grep -v '@$'; ls "$RUN" 2>/dev/null; } | sort -u |
        while read -r n; do
            definition "$n" >/dev/null 2>&1 || continue
            en=" "; enabled_list | grep -qx "$n" && en="*"
            printf '%s ' "$en"; do_status "$n"
        done
        echo "(* = enabled at boot)"; exit 0 ;;
    enable|disable)
        [ $# -eq 1 ] && valid_name "$1" || die "usage: $cmd NAME"
        definition "$1" >/dev/null || die "unknown service '$1'"
        [ "$(id -u)" = 0 ] || die "must be run as root"
        touch "$ENABLED"
        tmp="$(mktemp "$ENABLED.XXXXXX")"
        grep -vx "$1" "$ENABLED" > "$tmp" || true
        [ "$cmd" = enable ] && echo "$1" >> "$tmp"
        chmod 644 "$tmp"; mv "$tmp" "$ENABLED" ;;
    boot)
        mkdir -p "$RUN"; : > /run/gideon/services.order
        rc=0
        for n in $(enabled_list); do
            "$0" start "$n" || { echo "gideon-service: $n failed to start" >&2; rc=1; }
        done
        exit $rc ;;
    shutdown)
        for n in $(sed '1!G;h;$!d' /run/gideon/services.order 2>/dev/null); do
            "$0" stop "$n"
        done
        exit 0 ;;
    ''|-h|--help|help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown command '$cmd' (try --help)" ;;
esac
