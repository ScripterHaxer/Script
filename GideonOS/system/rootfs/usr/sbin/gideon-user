#!/bin/sh
# gideon-user: manage GideonOS user accounts.
#
#   gideon-user add NAME [--admin] [--fullname "Full Name"]
#   gideon-user del NAME [--keep-home]
#   gideon-user passwd NAME [--stdin]     (--stdin reads one line: the new password)
#   gideon-user list
#
# Regular users get uid >= 1000, a private home (0700), the gideon-session
# login shell, and the desktop groups (users audio video input cdrom).
# --admin adds them to wheel (allowed to administer the system).
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
DESKTOP_GROUPS="users audio video input cdrom"

die() { echo "gideon-user: $*" >&2; exit 2; }
need_root() { [ "$(id -u)" = 0 ] || die "must be run as root (try: su -c 'gideon-user ...')"; }
valid() { echo "$1" | grep -Eq '^[a-z_][a-z0-9_-]{0,30}$' || die "invalid user name '$1' (lowercase letters, digits, _ and -)"; }
exists() { grep -q "^$1:" /etc/passwd; }
uid_of() { awk -F: -v u="$1" '$1==u { print $3 }' /etc/passwd; }
regular() { u="$(uid_of "$1")"; [ -n "$u" ] && [ "$u" -ge 1000 ] && [ "$u" -lt 65534 ]; }

cmd="${1:-}"; [ $# -gt 0 ] && shift
case "$cmd" in
    add)
        need_root; [ $# -ge 1 ] || die "usage: add NAME [--admin] [--fullname NAME]"
        name="$1"; shift; admin=0; full="$name"
        while [ $# -gt 0 ]; do
            case "$1" in
                --admin) admin=1 ;;
                --fullname) [ $# -ge 2 ] || die "--fullname needs a value"; full="$2"; shift ;;
                *) die "unknown option '$1'" ;;
            esac; shift
        done
        valid "$name"; exists "$name" && die "user '$name' already exists"
        case "$full" in *:*) die "full name may not contain ':'" ;; esac
        # Next free uid >= 1000.
        uid="$(awk -F: 'BEGIN{m=999} $3>=1000 && $3<65534 && $3>m {m=$3} END{print m+1}' /etc/passwd)"
        addgroup -g "$uid" "$name"
        adduser -D -u "$uid" -G "$name" -h "/home/$name" -s /usr/bin/gideon-session -g "$full" -k /etc/skel "$name"
        chmod 0700 "/home/$name"
        for g in $DESKTOP_GROUPS; do addgroup "$name" "$g"; done
        [ "$admin" = 1 ] && addgroup "$name" wheel
        logger -t gideon-user "added user $name (uid $uid, admin=$admin)"
        echo "Created user '$name' (uid $uid). Set a password with: gideon-user passwd $name"
        ;;
    del)
        need_root; [ $# -ge 1 ] || die "usage: del NAME [--keep-home]"
        name="$1"; keep=0; [ "${2:-}" = --keep-home ] && keep=1
        valid "$name"; exists "$name" || die "no such user '$name'"
        regular "$name" || die "refusing to delete system account '$name'"
        home="$(awk -F: -v u="$name" '$1==u { print $6 }' /etc/passwd)"
        uid="$(uid_of "$name")"
        if pgrep -u "$uid" >/dev/null 2>&1; then die "user '$name' is logged in or has running processes"; fi
        deluser "$name"
        grep -q "^$name:" /etc/group && delgroup "$name"
        if [ "$keep" = 0 ] && [ "$home" = "/home/$name" ] && [ -d "$home" ]; then rm -rf "$home"; fi
        logger -t gideon-user "deleted user $name"
        echo "Deleted user '$name'."
        ;;
    passwd)
        [ $# -ge 1 ] || die "usage: passwd NAME [--stdin]"
        name="$1"; valid "$name"; exists "$name" || die "no such user '$name'"
        if [ "${2:-}" = --stdin ]; then
            need_root
            IFS= read -r pw || die "no password on stdin"
            [ -n "$pw" ] || die "empty password"
            case "$pw" in *:*) die "password may not contain ':'" ;; esac
            printf '%s:%s\n' "$name" "$pw" | chpasswd -c sha512
        else
            exec passwd "$name"
        fi
        ;;
    list)
        printf '%-12s %-6s %-6s %s\n' USER UID ADMIN NAME
        awk -F: '$3>=1000 && $3<65534 { print $1, $3, $5 }' /etc/passwd | while read -r u id full; do
            adm=no; grep -Eq "^wheel:[^:]*:[^:]*:(.*,)?$u(,|$)" /etc/group && adm=yes
            printf '%-12s %-6s %-6s %s\n' "$u" "$id" "$adm" "$full"
        done
        ;;
    ''|-h|--help|help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown command '$cmd' (try --help)" ;;
esac
