# sbin is on everyone's PATH so status tools (ip, gideon-service status) work;
# privileged operations still check for root themselves.
export PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin
export HOME="${HOME:-/root}" TERM="${TERM:-linux}" PAGER=less EDITOR=vi
TZ="$(gideon-config get time.timezone UTC0)"; export TZ
if [ "$(id -u)" = 0 ]; then PS1='\[\e[1;31m\]\u@\h\[\e[0m\]:\w# '; else PS1='\[\e[1;36m\]\u@\h\[\e[0m\]:\w$ '; fi
export PS1
for f in /etc/profile.d/*.sh; do [ -r "$f" ] && . "$f"; done
unset f
[ -r "$HOME/.profile" ] && . "$HOME/.profile"
