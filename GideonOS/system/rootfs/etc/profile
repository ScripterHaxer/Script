# sbin is on everyone's PATH so status tools work; privileged operations still
# check for root themselves.
export PATH=/usr/local/bin:/usr/bin:/usr/local/sbin:/usr/sbin
export PAGER=less EDITOR=vi
if [ "$(id -u)" = 0 ]; then PS1='\[\e[1;31m\]\u@\h\[\e[0m\]:\w# '; else PS1='\[\e[1;36m\]\u@\h\[\e[0m\]:\w$ '; fi
export PS1
for f in /etc/profile.d/*.sh; do [ -r "$f" ] && . "$f"; done
unset f
[ -r "$HOME/.profile" ] && [ "$HOME" != / ] && . "$HOME/.profile"
