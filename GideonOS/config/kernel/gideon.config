# GideonOS kernel configuration fragment.
# Applied on top of the upstream x86_64_defconfig via merge_config.sh.
# Only list options that differ from (or must be guaranteed in) defconfig.

CONFIG_LOCALVERSION="-gideon"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_DEFAULT_HOSTNAME="gideon"

# initramfs boot
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y

# Boot paths: BIOS (via GRUB) and UEFI
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y

# Consoles
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Virtual hardware used for development (QEMU)
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_INPUT=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_SCSI_VIRTIO=y

# Graphics foundation (used from milestone 3: DRM/KMS for Wayland)
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_VIRTIO_GPU=y

# Input (evdev is what libinput consumes)
CONFIG_INPUT_EVDEV=y

# Storage controllers for real hardware (NVMe laptops/desktops)
CONFIG_BLK_DEV_NVME=y

# Filesystems
CONFIG_EXT4_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_ISO9660_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NLS_UTF8=y
CONFIG_BLK_DEV_LOOP=y

# Security foundations (used from milestone 11)
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y

# --- Milestone 3 -------------------------------------------------------------
# systemd requirements (mirrors Buildroot's SYSTEMD_LINUX_CONFIG_FIXUPS)
CONFIG_CGROUPS=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_UNIX=y
CONFIG_FHANDLE=y
CONFIG_FW_LOADER_USER_HELPER=n
CONFIG_DMIID=y
CONFIG_DMI_SYSFS=y
CONFIG_BLK_DEV_BSG=y
CONFIG_NET_NS=y
CONFIG_IPV6=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_XATTR=y
CONFIG_KCMP=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_EFIVAR_FS=y
CONFIG_RT_GROUP_SCHED=n
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y

# Loadable modules, installed into the root image (/usr/lib/modules).
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# Real-hardware GPU drivers are modules so they load after the root image
# (and its /usr/lib/firmware) is mounted. VM display drivers stay built in.
CONFIG_DRM_I915=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_NOUVEAU=m

# Input: absolute pointers (QEMU usb-tablet, touchscreens) via HID
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
