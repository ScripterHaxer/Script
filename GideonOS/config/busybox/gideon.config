# GideonOS BusyBox overrides, applied on top of `make defconfig`.
# Format: CONFIG_X=y / CONFIG_X="value" / "# CONFIG_X is not set" semantics via =n.

# Fully static so the minimal userspace has no libc runtime dependency yet.
CONFIG_STATIC=y
# tc(8) does not build against current kernel headers (CBQ removed upstream).
CONFIG_TC=n
# Not needed: we use BusyBox init + our own rc scripts.
CONFIG_LINUXRC=n
# Password hashing: SHA-512 crypt (BusyBox default is DES, which is unacceptable).
CONFIG_FEATURE_DEFAULT_PASSWD_ALGO="sha512"
# setuid applets (su, passwd, login) keep their built-in privilege rules; no
# /etc/busybox.conf override mechanism.
CONFIG_FEATURE_SUID=y
CONFIG_FEATURE_SUID_CONFIG=n
